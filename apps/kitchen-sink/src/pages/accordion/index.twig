{% set current = "accordion" %}
{% extends "@layouts/base.twig" %}

{% block title %}Accordion — The Wheels kitchen-sink{% endblock %}

{% block content %}
  <h1>Accordion</h1>
  <p class="ks-meta">単体開閉 · chevron · 飛地グループ一斉開閉</p>

  <section>
    <h2>単体</h2>
    <tw-accordion>
      <span slot="header">セクション A</span>
      <div slot="content">
        <p>summary クリックまたは open/close で開閉します。chevron は向きが変わります。</p>
      </div>
    </tw-accordion>
    <tw-accordion>
      <span slot="header">セクション B（同時オープン可）</span>
      <div slot="content">
        <p>複数パネルを同時に開けます（排他モードなし）。</p>
      </div>
    </tw-accordion>
    <p class="ks-row">
      <tw-button
        type="button"
        id="open-first"
        variant="stroke"
        >最初を open()</tw-button
      >
      <tw-button
        type="button"
        id="close-first"
        variant="ghost"
        >最初を close()</tw-button
      >
    </p>
  </section>

  <section>
    <h2>グループ（飛地）</h2>
    <p class="ks-row">
      <button type="button" data-tw-accordion-open="faq">FAQ をすべて開く</button>
      <button type="button" data-tw-accordion-close="faq">FAQ をすべて閉じる</button>
    </p>

    <tw-accordion data-tw-accordion-group="faq">
      <span slot="header">FAQ 1</span>
      <div slot="content"><p>グループ faq のパネルです。</p></div>
    </tw-accordion>

    <div class="ks-disjoint">
      <p>（間に別コンテンツ）</p>
      <tw-accordion data-tw-accordion-group="other">
        <span slot="header">別グループ</span>
        <div slot="content"><p>こちらは影響を受けません。</p></div>
      </tw-accordion>
    </div>

    <tw-accordion data-tw-accordion-group="faq">
      <span slot="header">FAQ 2（飛地）</span>
      <div slot="content"><p>DOM 上離れていても同一グループです。</p></div>
    </tw-accordion>
  </section>
{% endblock %}

{% block scripts %}
  <script type="module">
    import "@b4moss/the-wheels";
  </script>
  <script type="module">
    const first = document.querySelector("tw-accordion");
    document.getElementById("open-first")?.addEventListener("click", () => {
      first?.open();
    });
    document.getElementById("close-first")?.addEventListener("click", () => {
      first?.close();
    });
  </script>
{% endblock %}
