{% set current = "vertical-nav" %}
{% extends "@layouts/app.twig" %}

{% block title %}Vertical Nav — The Wheels kitchen-sink{% endblock %}

{% block content %}
  <h1>Vertical Nav</h1>
  <p class="ks-meta">Item ラッパー · aria-current · layout-sidebar デモ</p>

  {% set preview %}
    <div class="layout-sidebar">
      <aside class="sidebar">
        <nav aria-label="プロジェクトメニュー">
          <ul style="list-style: none; margin: 0; padding: 0; max-width: none">
            <li style="max-width: none; margin: 0">
              <tw-vertical-nav>
                <a href="#home" aria-current="page">
                  <tw-svg-loader
                    id="nav-home-icon"
                    width="18"
                    height="18"
                  ></tw-svg-loader>
                  ホーム
                </a>
              </tw-vertical-nav>
            </li>
            <li style="max-width: none; margin: 0">
              <tw-vertical-nav>
                <a href="#docs">ドキュメント</a>
              </tw-vertical-nav>
            </li>
            <li style="max-width: none; margin: 0">
              <tw-vertical-nav>
                <a href="#members">メンバー</a>
              </tw-vertical-nav>
            </li>
            <li style="max-width: none; margin: 0">
              <tw-vertical-nav>
                <a href="#settings">設定</a>
              </tw-vertical-nav>
            </li>
          </ul>
        </nav>
      </aside>

      <section>
        <h2>メイン</h2>
        <p>
          リストは素の HTML、項目だけが <code>tw-vertical-nav</code> です。
          現在地は slot 内の <code>aria-current="page"</code> で指定します。
        </p>
        <p class="ks-focus-row">
          <tw-avatar name="山田太郎" width="48" height="48"></tw-avatar>
          <span>山田太郎 · プロダクトマネージャー</span>
        </p>
      </section>
    </div>
  {% endset %}

  {% set html_sample %}
<div class="layout-sidebar">
  <aside class="sidebar">
    <nav aria-label="プロジェクトメニュー">
      <ul>
        <li>
          <tw-vertical-nav>
            <a href="#home" aria-current="page">
              <tw-svg-loader id="…" width="18" height="18"></tw-svg-loader>
              ホーム
            </a>
          </tw-vertical-nav>
        </li>
        <li>
          <tw-vertical-nav>
            <a href="#docs">ドキュメント</a>
          </tw-vertical-nav>
        </li>
        <li>
          <tw-vertical-nav>
            <a href="#settings">設定</a>
          </tw-vertical-nav>
        </li>
      </ul>
    </nav>
  </aside>
  <section>
    <tw-avatar name="山田太郎" width="48" height="48"></tw-avatar>
  </section>
</div>
  {% endset %}
  {% set js_sample %}
import "@b4moss/the-wheels";
import menuUrl from "@b4moss/the-wheels-components/assets/menu.svg?url";

const icon = document.querySelector("#nav-home-icon");
if (icon) icon.setAttribute("src", menuUrl);
  {% endset %}
  {% set ts_sample %}
import "@b4moss/the-wheels";
import menuUrl from "@b4moss/the-wheels-components/assets/menu.svg?url";

const icon = document.querySelector("#nav-home-icon");
if (icon) icon.setAttribute("src", menuUrl);
  {% endset %}
  {% include "@partials/code-sample.twig" with {
    preview: preview,
    html: html_sample,
    js: js_sample,
    ts: ts_sample
  } only %}
{% endblock %}

{% block scripts %}
  <script type="module" src="/src/scripts/demos/vertical-nav.js"></script>
{% endblock %}
