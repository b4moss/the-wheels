<!doctype html>
<html lang="ja">
  <head>
    {% include "@partials/head.twig" %}
    <title>{% block title %}The Wheels — kitchen-sink{% endblock %}</title>
  </head>
  <body>
    {% block body %}
      <div class="ks-shell{% if shell_class %} {{ shell_class }}{% endif %}">
        {% include "@partials/nav.twig" %}
        <main>
          {% block content %}{% endblock %}
        </main>
      </div>
    {% endblock %}
    {% block scripts %}{% endblock %}
  </body>
</html>
