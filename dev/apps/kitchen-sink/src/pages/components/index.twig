{% set current = "components" %}
{% extends "@layouts/app.twig" %}

{% block title %}Components — The Wheels{% endblock %}

{% block content %}
  <h1>Components</h1>
  <p class="ks-meta">デモへのインデックス · Web Components とスタイル確認</p>

  <section>
    <h2>Web Components</h2>
    <ul>
      <li><a href="{{ site_base }}svg-loader/">SVGLoader</a> — SVG fetch・プレースホルダ</li>
      <li><a href="{{ site_base }}spinner/">Spinner</a> — 同梱アニメーション SVG</li>
      <li><a href="{{ site_base }}button/">Button</a> — variant / slot / disable-on-click</li>
      <li><a href="{{ site_base }}dropdown/">Dropdown</a> — trigger / panel / placement</li>
      <li><a href="{{ site_base }}dropdown-placement/">Dropdown placement</a> — Floating UI 端・中央フィクスチャ</li>
      <li><a href="{{ site_base }}action-menu/">ActionMenu</a> — more-vertical / src / カスタム trigger</li>
      <li><a href="{{ site_base }}user-menu/">UserMenu</a> — Avatar＋名前 trigger · Dropdown 合成</li>
      <li><a href="{{ site_base }}accordion/">Accordion</a> — details / chevron / グループ一斉開閉</li>
      <li><a href="{{ site_base }}modal/">Modal</a> — dialog / showModal / サイズ固定</li>
      <li><a href="{{ site_base }}avatar/">Avatar</a> — 書記素イニシャル · コントラスト · 画像</li>
      <li><a href="{{ site_base }}vertical-nav/">Vertical Nav</a> — Item · aria-current · layout-sidebar</li>
      <li><a href="{{ site_base }}tabs/">Tabs</a> — tab / panel · selected-index · select()</li>
      <li><a href="{{ site_base }}combobox/">Combobox</a> — static / async / hybrid · 検索 · 選択</li>
      <li><a href="{{ site_base }}infinite-scroll/">InfiniteScroll</a> — 上下ページング · ウィンドウ</li>
      <li><a href="{{ site_base }}cookie-consent/">CookieConsent</a> — 下部 snackbar · localStorage 同意</li>
    </ul>
  </section>

  <section>
    <h2>スタイル確認</h2>
    <ul>
      <li><a href="{{ site_base }}typography/">Typography</a> — 見出し・本文・40ch・focus</li>
      <li><a href="{{ site_base }}tokens/">Tokens</a> — 色と数値トークン</li>
    </ul>
  </section>
{% endblock %}
