{% set current = "tokens" %}
{% extends "@layouts/app.twig" %}

{% block title %}Tokens — The Wheels kitchen-sink{% endblock %}

{% block content %}
  <h1>Tokens</h1>
  <p class="ks-meta">`--tw-*` デザイントークン（v0.1.0）</p>

  <section>
    <h2>Colors</h2>
    <ul class="ks-swatches">
      <li class="ks-swatch">
        <span class="ks-swatch__chip" style="background: var(--tw-bg-page)"></span>
        <div class="ks-swatch__body">
          <span class="ks-swatch__name">--tw-bg-page</span>
          <span class="ks-swatch__value">#efefef</span>
        </div>
      </li>
      <li class="ks-swatch">
        <span class="ks-swatch__chip" style="background: var(--tw-bg-highlight)"></span>
        <div class="ks-swatch__body">
          <span class="ks-swatch__name">--tw-bg-highlight</span>
          <span class="ks-swatch__value">#ffffff</span>
        </div>
      </li>
      <li class="ks-swatch">
        <span class="ks-swatch__chip" style="background: var(--tw-text-main)"></span>
        <div class="ks-swatch__body">
          <span class="ks-swatch__name">--tw-text-main</span>
          <span class="ks-swatch__value">#494949</span>
        </div>
      </li>
      <li class="ks-swatch">
        <span class="ks-swatch__chip" style="background: var(--tw-text-caption)"></span>
        <div class="ks-swatch__body">
          <span class="ks-swatch__name">--tw-text-caption</span>
          <span class="ks-swatch__value">#747474</span>
        </div>
      </li>
      <li class="ks-swatch">
        <span class="ks-swatch__chip" style="background: var(--tw-text-highlight)"></span>
        <div class="ks-swatch__body">
          <span class="ks-swatch__name">--tw-text-highlight</span>
          <span class="ks-swatch__value">#000000</span>
        </div>
      </li>
      <li class="ks-swatch">
        <span class="ks-swatch__chip" style="background: var(--tw-bg-button-main)"></span>
        <div class="ks-swatch__body">
          <span class="ks-swatch__name">--tw-bg-button-main</span>
          <span class="ks-swatch__value">#3b3b3b</span>
        </div>
      </li>
      <li class="ks-swatch">
        <span class="ks-swatch__chip" style="background: var(--tw-bg-button-optional)"></span>
        <div class="ks-swatch__body">
          <span class="ks-swatch__name">--tw-bg-button-optional</span>
          <span class="ks-swatch__value">#e1e1e1</span>
        </div>
      </li>
      <li class="ks-swatch">
        <span class="ks-swatch__chip" style="background: var(--tw-bg-button-hover)"></span>
        <div class="ks-swatch__body">
          <span class="ks-swatch__name">--tw-bg-button-hover</span>
          <span class="ks-swatch__value">#000000</span>
        </div>
      </li>
      <li class="ks-swatch">
        <span class="ks-swatch__chip" style="background: var(--tw-alert)"></span>
        <div class="ks-swatch__body">
          <span class="ks-swatch__name">--tw-alert</span>
          <span class="ks-swatch__value">#bc2f2f</span>
        </div>
      </li>
    </ul>
  </section>

  <section>
    <h2>Typography / spacing</h2>
    <table class="ks-token-table">
      <thead>
        <tr>
          <th scope="col">Token</th>
          <th scope="col">Value</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><code>--tw-fz-root</code></td>
          <td>16</td>
        </tr>
        <tr>
          <td><code>--tw-heading-lh</code></td>
          <td>1.04</td>
        </tr>
        <tr>
          <td><code>--tw-body-text-lh</code></td>
          <td>1.7</td>
        </tr>
        <tr>
          <td><code>--tw-caption-lh</code></td>
          <td>1.3</td>
        </tr>
        <tr>
          <td><code>--tw-font-sans</code></td>
          <td>"Inter", "Noto Sans JP", sans-serif</td>
        </tr>
        <tr>
          <td><code>--tw-global-px</code></td>
          <td>100</td>
        </tr>
        <tr>
          <td><code>--tw-global-radius</code></td>
          <td>5</td>
        </tr>
        <tr>
          <td><code>--tw-global-radius-minor</code></td>
          <td>3</td>
        </tr>
      </tbody>
    </table>
  </section>

  <section>
    <h2>Breakpoints（unitless px）</h2>
    <table class="ks-token-table">
      <thead>
        <tr>
          <th scope="col">Token</th>
          <th scope="col">Value</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><code>--tw-bp-sm-start</code> … <code>--tw-bp-sm-end</code></td>
          <td>320 … 480</td>
        </tr>
        <tr>
          <td><code>--tw-bp-md-start</code> … <code>--tw-bp-md-end</code></td>
          <td>481 … 1279</td>
        </tr>
        <tr>
          <td><code>--tw-bp-lg-start</code> … <code>--tw-bp-lg-end</code></td>
          <td>1280 … 1679</td>
        </tr>
        <tr>
          <td><code>--tw-bp-xl-start</code> … <code>--tw-bp-xl-end</code></td>
          <td>1680 … 2560</td>
        </tr>
      </tbody>
    </table>
  </section>

  <section>
    <h2>サンプルコード</h2>
    {% set css_sample %}
@import "@b4moss/the-wheels/style";

.card {
  background: var(--tw-bg-highlight);
  color: var(--tw-text-main);
  border-radius: calc(var(--tw-global-radius) / 10 * 1rem);
  padding: 1.6rem;
}

.card__caption {
  color: var(--tw-text-caption);
  line-height: var(--tw-caption-lh);
}
    {% endset %}
    <div class="ks-sample">
      <h3 class="ks-sample__label">CSS</h3>
      {% include "@partials/code-block.twig" with { language: "css", code: css_sample } only %}
    </div>
  </section>
{% endblock %}
