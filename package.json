{
  "name": "the-wheels-reconstruct",
  "private": true,
  "version": "0.13.0",
  "type": "module",
  "description": "The Wheels monorepo (reconstruct)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:kitchen-sink": "npm run dev -w @b4moss/the-wheels-kitchen-sink",
    "preview:kitchen-sink": "npm run preview -w @b4moss/the-wheels-kitchen-sink",
    "dev:storybook": "npm run dev -w @b4moss/the-wheels-storybook",
    "build:style": "npm run build -w @b4moss/the-wheels-style",
    "build:components": "npm run build -w @b4moss/the-wheels-components",
    "build:the-wheels": "npm run build -w @b4moss/the-wheels",
    "build:kitchen-sink": "npm run build -w @b4moss/the-wheels-kitchen-sink",
    "build:storybook": "npm run build -w @b4moss/the-wheels-storybook",
    "test:components": "npm run test -w @b4moss/the-wheels-components",
    "test:package": "npm run build:components && npm run build:the-wheels && vitest run --config vitest.package.config.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "happy-dom": "^20.11.1",
    "typescript": "~5.6.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
