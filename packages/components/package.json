{
  "name": "@b4moss/the-wheels-components",
  "version": "0.13.0",
  "description": "The Wheels Web Components package",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "src",
    "assets",
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "build": "vite build",
    "sync:icons": "node ./scripts/sync-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@tabler/icons": "^3.46.0",
    "happy-dom": "^20.11.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0"
  }
}
